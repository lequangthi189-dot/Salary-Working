{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/salaryworking-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|active|alt|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, active, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:planned|overdue|received|ocr|neutral)$/]",
        "message": "<Badge> kind must be one of 'planned' | 'overdue' | 'received' | 'ocr' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|fullWidth|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, fullWidth, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|received|save|cancel|link|filter)$/]",
        "message": "<Button> variant must be one of 'primary' | 'received' | 'save' | 'cancel' | 'link' | 'filter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|totalHours|dayHours|nightHours|lostHours|pay|currencyLocale|children|style|key|ref|className|style|children)$/]",
        "message": "<DateGroup> doesn't accept that prop. Declared props: date, totalHours, dayHours, nightHours, lostHours, pay, currencyLocale, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|avatarUrl|initials|key|ref|className|style|children)$/]",
        "message": "<DockItem> doesn't accept that prop. Declared props: key, label, icon, avatarUrl, initials."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<FilterOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|width|style|key|ref|className|style|children)$/]",
        "message": "<Flag> doesn't accept that prop. Declared props: code, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute[name.name='code'] > Literal[value!=/^(?:vi|en|us|au)$/]",
        "message": "<Flag> code must be one of 'vi' | 'en' | 'us' | 'au'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|overlay|style|key|ref|className|style|children)$/]",
        "message": "<Loader> doesn't accept that prop. Declared props: label, overlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Message'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Message> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Message'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|info)$/]",
        "message": "<Message> tone must be one of 'error' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|onClose|width|footer|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, children, onClose, width, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:default|wide)$/]",
        "message": "<Modal> width must be one of 'default' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeriodCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dateRange|meta|pay|received|receivedOn|currencyLocale|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PeriodCard> doesn't accept that prop. Declared props: label, dateRange, meta, pay, received, receivedOn, currencyLocale, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<ProgressButton> doesn't accept that prop. Declared props: value, label, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SalaryHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|expectedLabel|lateLabel|deductionLabel|net|expected|latePenalty|deduction|fxNote|currencyLocale|style|key|ref|className|style|children)$/]",
        "message": "<SalaryHero> doesn't accept that prop. Declared props: label, expectedLabel, lateLabel, deductionLabel, net, expected, latePenalty, deduction, fxNote, currencyLocale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onClear|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, onChange, onClear, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShiftCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|scheduledStart|scheduledEnd|pay|lostHours|lateInHours|earlyOutHours|state|currencyLocale|onEdit|onDelete|style|key|ref|className|style|children)$/]",
        "message": "<ShiftCard> doesn't accept that prop. Declared props: start, end, scheduledStart, scheduledEnd, pay, lostHours, lateInHours, earlyOutHours, state, currencyLocale, onEdit, onDelete, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShiftCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:normal|planned|missing)$/]",
        "message": "<ShiftCard> state must be one of 'normal' | 'planned' | 'missing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|height|lines|size|radius|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: variant, width, height, lines, size, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:block|text|circle)$/]",
        "message": "<Skeleton> variant must be one of 'block' | 'text' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: title, value, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:orange|green|blue|red|none)$/]",
        "message": "<StatCard> tone must be one of 'orange' | 'green' | 'blue' | 'red' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|variant|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|total|pay|negative)$/]",
        "message": "<StatTile> variant must be one of 'default' | 'total' | 'pay' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|value|onChange|hint|error|numeric|required|placeholder|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, type, value, onChange, hint, error, numeric, required, placeholder, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|tel|date|number)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'password' | 'tel' | 'date' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeCycle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|order|label|swatch|icon|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<ThemeCycle> doesn't accept that prop. Declared props: value, onChange, order, label, swatch, icon, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|kind|label|title|required|style|key|ref|className|style|children)$/]",
        "message": "<TimeInput> doesn't accept that prop. Declared props: value, onChange, kind, label, title, required, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeInput'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:actual|in|out|scheduled)$/]",
        "message": "<TimeInput> kind must be one of 'actual' | 'in' | 'out' | 'scheduled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimesheetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|date|start|end|pay|key|ref|className|style|children)$/]",
        "message": "<TimesheetRow> doesn't accept that prop. Declared props: id, date, start, end, pay."
      }
    ]
  },
